# 本机后端；部署到服务器时使用持久化目录并在前面配置 HTTPS。
HOST=127.0.0.1
PORT=47832
DATA_DIR=./data
# 必须与用户访问的网址完全一致；留空时使用本机监听地址。
PUBLIC_ORIGIN=http://127.0.0.1:47832
NODE_ENV=development
# HTTPS 部署必须启用，防止会话通过 HTTP 发送。
COOKIE_SECURE=false
# 音乐文件上传限制，默认 100 MiB。
MAX_UPLOAD_MB=100
# 每个账号音乐存储配额，默认 2 GiB。
USER_STORAGE_MB=2048
# 可选：显式提供网页资源目录；留空时仅开放业务 API。
WEB_DIR=
